#!/bin/sh
set -eu

PATH=${GATEBSD_PATH:-/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin}
PYTHON_LAUNCHER=${GATEBSD_PYTHON_LAUNCHER:-/usr/local/libexec/gatebsd-python}

[ "$#" -eq 2 ] || { echo "usage: gatebsd-state-value <state.json> <key>" >&2; exit 64; }
STATE_FILE=$1
KEY=$2
[ -x "$PYTHON_LAUNCHER" ] || { echo "gatebsd-state-value: Python launcher is unavailable" >&2; exit 1; }

exec env -i PATH="$PATH" HOME=/root LANG=C.UTF-8 \
    "$PYTHON_LAUNCHER" -c '
import json
import os
import stat
import sys

path, key = sys.argv[1:3]
allowed = {
    "active_wan": str,
    "state": str,
    "mode": str,
    "manual_request": str,
    "reason": str,
    "last_switch": int,
    "request_id": str,
    "request_status": str,
    "request_error": str,
    "request_generation": int,
    "request_started": int,
    "primary_ru_ok": bool,
    "backup_ru_ok": bool,
}
if key not in allowed:
    raise SystemExit(64)
try:
    metadata = os.lstat(path)
except FileNotFoundError:
    raise SystemExit(0)
if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > 1048576:
    raise SystemExit(2)
try:
    with open(path, encoding="utf-8") as stream:
        document = json.load(stream)
    if not isinstance(document, dict):
        raise SystemExit(2)
    value = document.get(key)
except (OSError, UnicodeError, ValueError):
    raise SystemExit(2)
if value is None:
    raise SystemExit(0)
expected = allowed[key]
if type(value) is not expected:
    raise SystemExit(2)
if expected is int and value < 0:
    raise SystemExit(2)
if key == "active_wan" and value not in {"primary", "backup"}:
    raise SystemExit(2)
if key == "mode" and value not in {"observe", "automatic", "manual"}:
    raise SystemExit(2)
if key == "request_status" and value not in {"", "pending", "succeeded", "failed"}:
    raise SystemExit(2)
if expected is bool:
    print("true" if value else "false")
else:
    print(value)
' "$STATE_FILE" "$KEY"
