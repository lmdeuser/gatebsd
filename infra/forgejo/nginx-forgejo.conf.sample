server {
    listen 443 ssl;
    server_name git.example.lan;

    ssl_certificate     /usr/local/etc/ssl/n100-tls/server.crt;
    ssl_certificate_key /usr/local/etc/ssl/n100-tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:FORGEJOSSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 512m;

    location = / {
        return 302 /forgejo/;
    }

    location /forgejo/ {
        # The trailing slash strips the /forgejo/ prefix before forwarding, which
        # is required because Forgejo is configured with ROOT_URL containing the
        # prefix and rewrites its own links accordingly. Removing the slash makes
        # Forgejo 404 every request.
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /health/forgejo {
        proxy_pass http://127.0.0.1:3000/api/healthz;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        return 404;
    }
}
